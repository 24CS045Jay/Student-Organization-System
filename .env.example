# ==============================================================================
# ClubSphere Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual API credentials.
# ==============================================================================

# Application Setup
VITE_APP_ENV=development
VITE_APP_NAME="ClubSphere"
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 1. Supabase Backend Integration (PostgreSQL Database & Auth)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_SUPABASE_STORAGE_BUCKET=clubsphere-assets

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway Integration
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. Email API Integration (Resend)
# ------------------------------------------------------------------------------
EMAIL_API_KEY=your_key_here
EMAIL_FROM=club@example.com
VITE_RESEND_API_KEY=your_key_here
VITE_RESEND_FROM_EMAIL=club@example.com


# ------------------------------------------------------------------------------
# 4. Standard SMTP / Mailgun Fallback Integration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_SECURE=true

# ------------------------------------------------------------------------------
# 5. WhatsApp & SMS Notifications (Optional)
# ------------------------------------------------------------------------------
WHATSAPP_API_KEY=your_whatsapp_business_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
